<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardElevation="@dimen/card_elevation"
    app:cardCornerRadius="@dimen/corner_radius_md"
    android:layout_marginBottom="@dimen/spacing_sm"
    android:layout_marginHorizontal="@dimen/spacing_xs">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/card_padding">

        <!-- Imagen del producto -->
        <ImageView
            android:id="@+id/catalogo_product_image"
            android:layout_width="@dimen/product_card_mini_image"
            android:layout_height="@dimen/product_card_mini_image"
            android:scaleType="centerCrop"
            android:contentDescription="@string/cd_product_image"
            android:background="@color/surface_container_low" />

        <!-- Detalles -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_md"
            android:orientation="vertical">

            <TextView
                android:id="@+id/catalogo_product_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.App.LabelSmall"
                android:textColor="@color/tertiary"
                android:fontFamily="@font/manrope" />

            <TextView
                android:id="@+id/catalogo_product_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textAppearance="@style/TextAppearance.App.HeadlineSmall"
                android:fontFamily="@font/noto_serif"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/catalogo_product_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textAppearance="@style/TextAppearance.App.BodySmall"
                android:fontFamily="@font/inter"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- Precio + Botón -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/catalog_label_price_per_unit"
                        android:textAppearance="@style/TextAppearance.App.BodySmall"
                        android:textColor="@color/on_surface_variant"
                        android:fontFamily="@font/inter" />

                    <TextView
                        android:id="@+id/catalogo_product_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.App.Price"
                        android:fontFamily="@font/noto_serif"
                        android:textStyle="bold" />
                </LinearLayout>

                <Button
                    android:id="@+id/catalogo_product_btn_add"
                    style="@style/Widget.App.Button.Primary"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_button_primary"
                    android:contentDescription="@string/cd_btn_add_to_cart"
                    android:padding="0dp"
                    app:icon="@android:drawable/ic_input_add"
                    app:iconTint="@color/on_primary"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
