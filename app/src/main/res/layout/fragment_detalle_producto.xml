<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- AppBar con botón atrás -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/detalle_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/detalle_toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/top_app_bar_height"
            app:navigationIcon="@android:drawable/ic_menu_revert"
            app:navigationContentDescription="@string/action_back" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Contenido scrollable -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none"
        android:paddingBottom="100dp"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Imagen principal -->
            <ImageView
                android:id="@+id/detalle_image"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:scaleType="centerCrop"
                android:contentDescription="@string/cd_product_image"
                android:background="@color/surface_container_low" />

            <!-- Info del producto -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_horizontal_padding"
                android:paddingTop="@dimen/spacing_lg">

                <!-- Categoría -->
                <TextView
                    android:id="@+id/detalle_categoria"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.App.LabelSmall"
                    android:textColor="@color/tertiary"
                    android:fontFamily="@font/manrope"
                    android:textStyle="bold" />

                <!-- Nombre -->
                <TextView
                    android:id="@+id/detalle_nombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:textAppearance="@style/TextAppearance.App.Headline"
                    android:fontFamily="@font/noto_serif"
                    android:textStyle="bold" />

                <!-- Marca y presentación -->
                <TextView
                    android:id="@+id/detalle_marca"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:textAppearance="@style/TextAppearance.App.BodySmall"
                    android:textColor="@color/on_surface_variant"
                    android:fontFamily="@font/inter" />

                <!-- Precio -->
                <TextView
                    android:id="@+id/detalle_precio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:textAppearance="@style/TextAppearance.App.Price"
                    android:textSize="28sp"
                    android:fontFamily="@font/noto_serif"
                    android:textStyle="bold"
                    android:textColor="@color/primary" />

                <!-- Stock -->
                <TextView
                    android:id="@+id/detalle_stock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:textAppearance="@style/TextAppearance.App.BodySmall"
                    android:fontFamily="@font/inter" />

                <!-- Divisor -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/divider_height"
                    android:layout_marginVertical="@dimen/spacing_lg"
                    android:background="@color/surface_container_high" />

                <!-- Descripción -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/product_section_description"
                    android:textAppearance="@style/TextAppearance.App.HeadlineMedium"
                    android:fontFamily="@font/noto_serif"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/detalle_descripcion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:textAppearance="@style/TextAppearance.App.Body"
                    android:textColor="@color/on_surface_variant"
                    android:fontFamily="@font/inter"
                    android:lineSpacingMultiplier="1.5" />

                <!-- Selector de cantidad -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xl"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/product_label_quantity"
                        android:textAppearance="@style/TextAppearance.App.HeadlineMedium"
                        android:fontFamily="@font/noto_serif"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_quantity_selector"
                        android:paddingHorizontal="@dimen/spacing_xs">

                        <ImageButton
                            android:id="@+id/detalle_btn_decrease"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/cd_btn_decrease_quantity"
                            android:src="@android:drawable/ic_menu_close_clear_cancel"
                            android:tint="@color/on_surface_variant" />

                        <TextView
                            android:id="@+id/detalle_cantidad"
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/product_label_default_quantity"
                            android:textAppearance="@style/TextAppearance.App.Label"
                            android:fontFamily="@font/manrope"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/detalle_btn_increase"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/cd_btn_increase_quantity"
                            android:src="@android:drawable/ic_input_add"
                            android:tint="@color/primary" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Botón flotante: Agregar al carrito -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:elevation="8dp"
        app:cardCornerRadius="0dp"
        app:cardBackgroundColor="@color/surface">

        <Button
            android:id="@+id/detalle_btn_add_cart"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height_primary"
            android:layout_margin="@dimen/spacing_lg"
            android:text="@string/product_btn_add_cart"
            android:background="@drawable/bg_button_primary"
            android:textColor="@color/on_primary"
            android:fontFamily="@font/manrope"
            android:textAllCaps="false"
            android:textStyle="bold" />
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>