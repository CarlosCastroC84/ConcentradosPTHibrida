<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.App.Card.Surface"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/card_padding"
        android:gravity="center_vertical">

        <!-- Imagen -->
        <ImageView
            android:id="@+id/carrito_item_image"
            android:layout_width="@dimen/product_card_mini_image"
            android:layout_height="@dimen/product_card_mini_image"
            android:scaleType="centerCrop"
            android:contentDescription="@string/cd_product_image"
            android:background="@color/surface_container" />

        <!-- Info producto -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_md"
            android:orientation="vertical">

            <TextView
                android:id="@+id/carrito_item_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.App.HeadlineSmall"
                android:fontFamily="@font/noto_serif"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/carrito_item_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxs"
                android:text="@string/cart_item_unit"
                android:textAppearance="@style/TextAppearance.App.BodySmall"
                android:fontFamily="@font/inter" />

            <TextView
                android:id="@+id/carrito_item_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textAppearance="@style/TextAppearance.App.Price"
                android:fontFamily="@font/noto_serif"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Selector de cantidad -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_quantity_selector"
            android:paddingHorizontal="@dimen/spacing_xs">

            <ImageButton
                android:id="@+id/carrito_item_btn_decrease"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_btn_decrease_quantity"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="@color/on_surface_variant" />

            <TextView
                android:id="@+id/carrito_item_quantity"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.App.Label"
                android:fontFamily="@font/manrope"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/carrito_item_btn_increase"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_btn_increase_quantity"
                android:src="@android:drawable/ic_input_add"
                android:tint="@color/primary" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
