<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinator_vendedor"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/vendedor_nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/bottom_nav_height"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph_vendedor"
        tools:layout="@layout/fragment_panel_productos_vendedor" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/vendedor_bottom_nav_view"
        style="@style/Widget.App.BottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_nav"
        android:elevation="@dimen/elevation_bottom_nav"
        android:paddingBottom="8dp"
        app:itemIconSize="24dp"
        app:itemRippleColor="@color/primary_fixed"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_vendedor_menu" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
