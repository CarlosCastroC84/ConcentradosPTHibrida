<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_horizontal_padding"
        android:paddingTop="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_xl">

        <!-- Título y bienvenida -->
        <TextView
            android:id="@+id/dashboard_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dashboard_title"
            android:textAppearance="@style/TextAppearance.App.Headline"
            android:fontFamily="@font/noto_serif"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:text="@string/dashboard_welcome"
            android:textAppearance="@style/TextAppearance.App.BodySmall"
            android:fontFamily="@font/inter"
            android:textColor="@color/on_surface_variant" />

        <!-- Nuevo Reporte -->
        <Button
            android:id="@+id/dashboard_btn_new_report"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/btn_height_secondary"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/dashboard_btn_new_report"
            android:background="@drawable/bg_button_primary"
            android:textColor="@color/on_primary"
            android:fontFamily="@font/manrope"
            android:textAllCaps="false" />

        <!-- KPIs: Ventas Totales -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dashboard_card_sales"
            style="@style/Widget.App.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_kpi_total_sales"
                    android:textAppearance="@style/TextAppearance.App.LabelSmall"
                    android:fontFamily="@font/manrope"
                    android:textColor="@color/on_surface_variant" />

                <TextView
                    android:id="@+id/dashboard_total_sales"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="$45,230.00"
                    android:textAppearance="@style/TextAppearance.App.Price"
                    android:textSize="@dimen/text_price_large"
                    android:fontFamily="@font/noto_serif"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- KPIs fila: Pedidos y Usuarios -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/dashboard_card_orders"
                style="@style/Widget.App.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_kpi_new_orders"
                        android:textAppearance="@style/TextAppearance.App.LabelSmall"
                        android:fontFamily="@font/manrope"
                        android:textColor="@color/on_surface_variant" />

                    <TextView
                        android:id="@+id/dashboard_new_orders"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:textAppearance="@style/TextAppearance.App.HeadlineMedium"
                        android:fontFamily="@font/noto_serif"
                        android:textStyle="bold"
                        android:textColor="@color/primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_kpi_new_orders_badge"
                        android:textAppearance="@style/TextAppearance.App.LabelSmall"
                        android:textColor="@color/secondary"
                        android:fontFamily="@font/manrope" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/dashboard_card_users"
                style="@style/Widget.App.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_kpi_active_users"
                        android:textAppearance="@style/TextAppearance.App.LabelSmall"
                        android:fontFamily="@font/manrope"
                        android:textColor="@color/on_surface_variant" />

                    <TextView
                        android:id="@+id/dashboard_active_users"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:textAppearance="@style/TextAppearance.App.HeadlineMedium"
                        android:fontFamily="@font/noto_serif"
                        android:textStyle="bold"
                        android:textColor="@color/primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Acceso Rápido: Productos -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:text="@string/dashboard_quick_access"
            android:textAppearance="@style/TextAppearance.App.HeadlineMedium"
            android:fontFamily="@font/noto_serif"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dashboard_quick_products"
            style="@style/Widget.App.Card.Surface"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_md"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_quick_products"
                        android:textAppearance="@style/TextAppearance.App.Body"
                        android:fontFamily="@font/inter"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_quick_products_sub"
                        android:textAppearance="@style/TextAppearance.App.BodySmall"
                        android:fontFamily="@font/inter" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/icon_md"
                    android:layout_height="@dimen/icon_md"
                    android:src="@android:drawable/arrow_up_float"
                    app:tint="@color/on_surface_variant"
                    android:contentDescription="@null" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Acceso Rápido: Usuarios -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dashboard_quick_users"
            style="@style/Widget.App.Card.Surface"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_md"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_quick_users"
                        android:textAppearance="@style/TextAppearance.App.Body"
                        android:fontFamily="@font/inter"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_quick_users_sub"
                        android:textAppearance="@style/TextAppearance.App.BodySmall"
                        android:fontFamily="@font/inter" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/icon_md"
                    android:layout_height="@dimen/icon_md"
                    android:src="@android:drawable/arrow_up_float"
                    app:tint="@color/on_surface_variant"
                    android:contentDescription="@null" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Pedidos Recientes -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:text="@string/dashboard_section_recent_orders"
            android:textAppearance="@style/TextAppearance.App.HeadlineMedium"
            android:fontFamily="@font/noto_serif"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dashboard_rv_recent_orders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:nestedScrollingEnabled="false" />

        <Button
            android:id="@+id/dashboard_btn_logout"
            style="@style/Widget.App.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height_secondary"
            android:layout_marginTop="@dimen/spacing_xl"
            android:text="@string/profile_action_logout"
            android:textAllCaps="false"
            android:fontFamily="@font/manrope" />

    </LinearLayout>
</ScrollView>
